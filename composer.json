{
    "name": "hyperf/model-cache",
    "description": "Hyperf ModelCache fork with request-scoped snapshots, Redis cache and safe invalidation.",
    "license": "MIT",
    "keywords": [
        "php",
        "hyperf",
        "model-cache"
    ],
    "homepage": "https://hyperf.io",
    "support": {
        "issues": "https://github.com/droid240418/model-cache/issues",
        "source": "https://github.com/droid240418/model-cache",
        "docs": "https://hyperf.wiki",
        "pull-request": "https://github.com/hyperf/hyperf/pulls"
    },
    "require": {
        "php": ">=8.2",
        "hyperf/codec": "~3.2.0",
        "hyperf/collection": "~3.2.0",
        "hyperf/context": "~3.2.0",
        "hyperf/contract": "~3.2.0",
        "hyperf/db-connection": "~3.2.0",
        "hyperf/support": "~3.2.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "psr/http-server-middleware": "^1.0"
    },
    "suggest": {
        "hyperf/event": "Required to use DeleteCacheListener."
    },
    "autoload": {
        "psr-4": {
            "Hyperf\\ModelCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\ModelCache\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.2-dev"
        },
        "hyperf": {
            "config": "Hyperf\\ModelCache\\ConfigProvider"
        }
    },
    "require-dev": {
        "hyperf/config": "~3.2.0",
        "hyperf/event": "~3.2.0",
        "hyperf/redis": "~3.2.0",
        "hyperf/framework": "~3.2.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "phpstan/phpstan": "^2.0",
        "hyperf/testing": "~3.2.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "co-phpunit --prepend tests/bootstrap.php --colors=always",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
